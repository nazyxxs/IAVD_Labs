 "код_студента": {
  "tournament": "def tournament(F, k, rng):\n    idx = rng.integers(0, len(F), size=k)      # k випадкових номерів особин (можуть повторюватись)\n    return int(idx[np.argmin(F[idx])])         # номер тієї, в якої найкоротший маршрут\n",
  "ox": "def ox(p1, p2, i, j):\n    n = len(p1)\n    child = np.zeros(n, dtype=p1.dtype)        # порожній нащадок такої ж довжини\n    child[i:j + 1] = p1[i:j + 1]               # крок 1: шматок від батька 1 на ті самі місця\n    taken = set(p1[i:j + 1].tolist())          # які точки вже є в нащадку\n    pos = (j + 1) % n                          # куди ставити наступну точку\n    for s in range(n):\n        gene = p2[(j + 1 + s) % n]             # крок 2: йдемо по p2 від j+1 по колу\n        if gene in taken:                      # крок 3: таку точку вже маємо, пропускаємо\n            continue\n        child[pos] = gene                      # крок 4: ставимо на вільне місце\n        pos = (pos + 1) % n                    # наступне вільне місце (по колу)\n    return child\n",
  "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    left = np.array(left)                                   # список невідвіданих точок -> масив\n    w = tau[cur, left] ** alpha * eta[cur, left] ** beta    # вага кожної невідвіданої точки\n    p = w / w.sum()                                         # ваги -> ймовірності (сума = 1)\n    return int(rng.choice(left, p=p))                       # «рулетка»: обираємо точку з цими ймовірностями\n",
  "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    new = (1 - rho) * tau                         # крок 1: випаровування (нова матриця, стару не чіпаємо)\n    for g, L in zip(tours, lens):                 # для кожної мурахи: її маршрут і довжина\n        t = np.concatenate(([0], g, [0]))         # додаємо вокзал на початок і кінець\n        new[t[:-1], t[1:]] += 1.0 / L             # крок 2: +1/L на кожне ребро i -> j маршруту\n    return new\n"
 },
